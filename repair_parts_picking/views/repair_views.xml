<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_repair_order_form_parts_picking" model="ir.ui.view">
        <field name="name">repair.order.form - repair_parts_picking</field>
        <field name="model">repair.order</field>
        <field name="inherit_id" ref="repair.view_repair_order_form" />
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button
                    name="action_return_leftovers"
                    type="object"
                    string="Return leftover parts"
                    invisible="state not in ('under_repair', 'done')"
                />
            </xpath>
            <xpath expr="//div[@name='button_box']" position="inside">
                <button
                    name="action_view_parts_pickings"
                    type="object"
                    class="oe_stat_button"
                    icon="fa-truck"
                    invisible="parts_picking_count == 0"
                >
                    <field
                        name="parts_picking_count"
                        widget="statinfo"
                        string="Transfers"
                    />
                </button>
            </xpath>
        </field>
    </record>
    <record id="repair_view_picking_type_form_parts_picking" model="ir.ui.view">
        <field name="name">stock.picking.type.form - repair_parts_picking</field>
        <field name="model">stock.picking.type</field>
        <field name="inherit_id" ref="repair.repair_view_picking_type_form" />
        <field name="arch" type="xml">
            <xpath
                expr="//field[@name='removed_condemned_location_id']"
                position="after"
            >
                <field
                    name="removed_by_transfer"
                    invisible="code != 'repair_operation'"
                />
                <field
                    name="removed_staging_location_id"
                    options="{'no_create': True}"
                    invisible="code != 'repair_operation' or not removed_by_transfer"
                    required="removed_by_transfer"
                />
            </xpath>
        </field>
    </record>
</odoo>
