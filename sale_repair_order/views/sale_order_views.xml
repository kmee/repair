<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_order_form_repair" model="ir.ui.view">
        <field name="name">sale.order.form - sale_repair_order</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='payment_term_id']" position="after">
                <field name="repair_mode" invisible="1" />
                <field name="repair_id" invisible="not repair_id" />
                <field name="repair_role" invisible="not repair_id" />
            </xpath>
        </field>
    </record>
</odoo>
