<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_company_form_repair_approval" model="ir.ui.view">
        <field name="name">res.company.form - repair_item_approval</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="base.view_company_form" />
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Repair Approval" name="repair_approval">
                    <group>
                        <group>
                            <field name="repair_approval_currency_id" />
                            <field name="repair_approval_limit" />
                            <field name="repair_approval_base" />
                        </group>
                        <group>
                            <field name="repair_approval_inclusive" />
                            <field name="repair_approval_cumulative" />
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
