<?xml version="1.0" encoding="utf-8" ?>
<odoo noupdate="1">
    <!--
        Group rules are OR-ed together and AND-ed with the global multi-company
        rule. A rule for the salesman alone would restrict users that also have
        the stock user group: the explicit "all" rules avoid that trap.
    -->
    <record id="repair_order_rule_stock_user" model="ir.rule">
        <field name="name">Repair order: stock users see all</field>
        <field name="model_id" ref="repair.model_repair_order" />
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('stock.group_stock_user'))]" />
    </record>
    <record id="repair_order_rule_salesman_all" model="ir.rule">
        <field name="name">Repair order: salesman, all documents</field>
        <field name="model_id" ref="repair.model_repair_order" />
        <field name="domain_force">[(1, '=', 1)]</field>
        <field
            name="groups"
            eval="[(4, ref('sales_team.group_sale_salesman_all_leads'))]"
        />
    </record>
    <record id="repair_order_rule_salesman_own" model="ir.rule">
        <field name="name">Repair order: salesman, own sale orders</field>
        <field name="model_id" ref="repair.model_repair_order" />
        <field
            name="domain_force"
        >['|', ('sale_order_id.user_id', '=', user.id), ('sale_order_ids.user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('sales_team.group_sale_salesman'))]" />
    </record>
    <record id="repair_service_rule_stock_user" model="ir.rule">
        <field name="name">Repair service: stock users see all</field>
        <field name="model_id" ref="repair_service.model_repair_service" />
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('stock.group_stock_user'))]" />
    </record>
    <record id="repair_service_rule_salesman_all" model="ir.rule">
        <field name="name">Repair service: salesman, all documents</field>
        <field name="model_id" ref="repair_service.model_repair_service" />
        <field name="domain_force">[(1, '=', 1)]</field>
        <field
            name="groups"
            eval="[(4, ref('sales_team.group_sale_salesman_all_leads'))]"
        />
    </record>
    <record id="repair_service_rule_salesman_own" model="ir.rule">
        <field name="name">Repair service: salesman, own sale orders</field>
        <field name="model_id" ref="repair_service.model_repair_service" />
        <field
            name="domain_force"
        >['|', ('repair_id.sale_order_id.user_id', '=', user.id), ('repair_id.sale_order_ids.user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('sales_team.group_sale_salesman'))]" />
    </record>
</odoo>
