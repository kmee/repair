<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_repair_order_form_sale_repair_order" model="ir.ui.view">
        <field name="name">repair.order.form - sale_repair_order</field>
        <field name="model">repair.order</field>
        <field name="inherit_id" ref="repair.view_repair_order_form" />
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button
                    name="action_view_sale_orders"
                    type="object"
                    class="oe_stat_button"
                    icon="fa-shopping-cart"
                    invisible="order_count == 0"
                >
                    <field name="order_count" widget="statinfo" string="Sale Orders" />
                </button>
            </xpath>
            <xpath expr="//field[@name='repair_service_ids']/list" position="inside">
                <field name="sale_line_id" optional="hide" readonly="1" />
            </xpath>
        </field>
    </record>
</odoo>
