<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_order_form_complementary" model="ir.ui.view">
        <field name="name">sale.order.form - repair_complementary_quotation</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale_repair_order.view_order_form_repair" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='repair_role']" position="after">
                <field name="complement_of_id" invisible="not complement_of_id" />
            </xpath>
        </field>
    </record>
</odoo>
